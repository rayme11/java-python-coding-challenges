# ==============================================================================
# Azure OpenAI & Enterprise QE Lab Environment Configuration
# Copy this file to .env and fill in your secure enterprise credentials
# ==============================================================================

# Azure OpenAI Service Configuration
AZURE_OPENAI_API_KEY="your_azure_openai_api_key_here"
AZURE_OPENAI_ENDPOINT="https://rg-ai-qe-lab-prod.openai.azure.com/openai/v1"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4.1-mini"
AZURE_OPENAI_API_VERSION="2024-02-01" # Use a stable API version

# Azure AI Search Configuration (for RAG)
AZURE_SEARCH_ENDPOINT="https://your-search-service-name.search.windows.net"
AZURE_SEARCH_ADMIN_KEY="your_azure_search_admin_key_here"

# Local MCP Server Configuration
LOCAL_MCP_SERVER_PORT=8000
INTERNAL_TEST_DB_PATH="./mcp_server/test_metrics.db"
